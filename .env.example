# THAI-MOD model selection
# auto: prefer WangchanBERTa artifact if present, otherwise fall back to LR
# lr: always use TF-IDF + Logistic Regression
# bert: require WangchanBERTa artifact and fail if it is missing
THAI_MOD_MODEL_BACKEND=auto

# Optional MLflow config used when a model is trained, not when a cached model is only loaded.
# Leave THAI_MOD_MLFLOW_TRACKING_URI empty to use MLflow's local default ./mlruns directory.
THAI_MOD_MLFLOW_EXPERIMENT=thai-mod
# THAI_MOD_MLFLOW_TRACKING_URI=http://127.0.0.1:5000
